{
  "version": 2,
  "installCommand": "cd portfolio-frontend && npm install",
  "buildCommand": "cd portfolio-frontend && npm run build",
  "outputDirectory": "portfolio-frontend/dist/portfolio-frontend/browser",
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/blog/rss.xml",
      "destination": "https://portfolio-backend-jsyz.onrender.com/api/blogposts/rss"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
